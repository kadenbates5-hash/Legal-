{
  "name": "legal-ai-core",
  "version": "0.1.0",
  "description": "Core routing, confidentiality, escalation, audit, and human-review-gate engine for the AI receptionist & paralegal system. Practice-area and firm-level layers plug in on top of this.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.3.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:assets",
    "build:assets": "mkdir -p dist/review-ui/public && cp -r src/review-ui/public/. dist/review-ui/public/",
    "start": "node dist/review-ui/start.js",
    "start:review-ui": "npm run build && node dist/review-ui/start.js",
    "sync:calendar": "npm run build && node dist/integrations/sync-calendar-deadlines.js",
    "sync:calendar:push": "npm run build && node dist/integrations/sync-appointments-to-calendar.js",
    "send:reminders": "npm run build && node dist/integrations/send-appointment-reminders.js",
    "anchor:audit": "npm run build && node dist/integrations/anchor-audit.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.20.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0"
  }
}
